# Copy to .env and fill in. Never commit .env.

# Supabase public client (reads via get_event RPC)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role (server-side writes only, never exposed to the browser).
# Supabase dashboard > Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (bot check on create).
# Dev/test always-pass keys: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA. Replace before going live.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Base URL used when building share links / QR codes (no trailing slash).
PUBLIC_SITE_URL=https://tagor.app

# Secret salt for hashing IPs in the rate limiter (any long random string).
RATE_LIMIT_SALT=
