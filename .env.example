# Supabase - the tiny backend. Fill these in .env (never commit .env).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile - bot check on the create form.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Base URL used when building share links / QR codes (no trailing slash).
PUBLIC_SITE_URL=https://tagor.app
