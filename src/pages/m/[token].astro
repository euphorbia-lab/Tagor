---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ManageView from '../../components/ManageView.tsx';
import { getServiceClient } from '../../lib/supabase';

// SSR shell only. The content is encrypted, so the summary and the edit form
// are populated in the browser from the key in the URL fragment.
export const prerender = false;

const { token } = Astro.params;

let ev: {
  payload: string | null;
  start_at: string;
  end_at: string | null;
  all_day: boolean;
  lang: string;
  view_slug: string;
  image_count: number;
} | null = null;

if (token) {
  const { data, error } = await getServiceClient()
    .from('events')
    .select('payload, start_at, end_at, all_day, lang, view_slug, image_count')
    .eq('manage_token', token)
    .maybeSingle();
  if (error) console.error('manage lookup failed:', error.message);
  ev = data as typeof ev;
}

if (!ev) {
  return new Response(null, { status: 404 });
}

const lang = ev.lang === 'en' ? 'en' : 'es';
const L =
  lang === 'en'
    ? { title: 'Manage your event' }
    : { title: 'Gestiona tu evento' };

const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.url.origin;
const viewUrl = `${siteUrl}/e/${ev.view_slug}`;
const imageBase = `${import.meta.env.PUBLIC_SUPABASE_URL}/storage/v1/object/public/event-images/${ev.view_slug}`;
---

<BaseLayout title={`${L.title} · Tagor`} lang={lang} noindex={true}>
  <main class="wrap">
    <a href="/" class="muted back">← Tagor</a>
    <h1>{L.title}</h1>

    <ManageView
      client:load
      payload={ev.payload ?? ''}
      start_at={ev.start_at}
      end_at={ev.end_at}
      all_day={ev.all_day}
      lang={lang}
      manageToken={token as string}
      viewUrl={viewUrl}
      imageCount={ev.image_count ?? 0}
      imageBase={imageBase}
    />
  </main>

  <style>
    .back { display: inline-block; margin-bottom: 20px; }
    h1 { font-size: 28px; letter-spacing: -0.02em; margin: 0 0 20px; }
  </style>
</BaseLayout>
