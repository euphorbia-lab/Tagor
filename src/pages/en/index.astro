---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/ui';

export const prerender = true;

const t = useTranslations('en');

// Explicit structured data so search summarizers describe Tagor correctly:
// there is no discovery or public browsing, only link-only sharing.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Tagor',
  url: 'https://tagor.app/en/',
  description: t('site.description'),
  applicationCategory: 'Private event sharing tool',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  featureList: [
    'Create an event and share it as a private link or QR code',
    'End-to-end encrypted: the key travels in the link and the server cannot read the event',
    'No accounts or sign-up required',
    'No public event list or search, access is link-only',
    'No user tracking or analytics',
    'Up to 3 photos, encrypted and stripped of location metadata',
    'The event deletes itself automatically about 14 days later',
  ],
};

const alternates = { es: '/', en: '/en/' };
---

<BaseLayout
  title="Tagor"
  description={t('site.description')}
  lang="en"
  jsonLd={jsonLd}
  alternates={alternates}
  langRedirect="en"
>
  <main class="wrap">
    <header class="top">
      <img src="/logo.png" alt="Tagor" class="logo" />
      <nav class="top__nav">
        <a href="/">ES</a>
        <button id="theme-toggle" class="icon-btn" aria-label="Toggle theme">◐</button>
      </nav>
    </header>

    <section class="hero">
      <div class="hero__web">
        <h1>{t('site.tagline')}</h1>
        <p class="muted lead">{t('site.description')}</p>
      </div>

      <div class="hero__native">
        <ol class="how-steps">
          <li>{t('how.native.1')}</li>
          <li>{t('how.native.2')}</li>
          <li>{t('how.native.3')}</li>
        </ol>
      </div>

      <a href="/en/nuevo" class="btn btn--primary">{t('nav.create')}</a>
      <p class="hero__native-caption">{t('create.privatelyCaption')}</p>
    </section>

    <section class="how how--web">
      <ul>
        <li>{t('how.1')}</li>
        <li>{t('how.2')}</li>
        <li>{t('how.3')}</li>
        <li>{t('how.4')}</li>
        <li>{t('how.5')}</li>
      </ul>
    </section>

    <footer class="foot muted">
      <a href="/en/legal/">Legal & privacy</a> ·
      <a href="https://github.com/euphorbia-lab/Tagor" target="_blank" rel="noopener">Open source</a>
    </footer>
  </main>

  <script is:inline>
    const btn = document.getElementById('theme-toggle');
    btn?.addEventListener('click', () => {
      const root = document.documentElement;
      const current =
        root.getAttribute('data-theme') ||
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('tagor-theme', next);
      } catch (_) {}
    });
  </script>

  <style>
    .top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0;
    }
    .logo {
      height: 46px;
      width: auto;
      display: block;
    }
    .top__nav {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .top__nav a {
      color: var(--text-muted);
      font-weight: 600;
      font-size: 14px;
    }
    .foot {
      margin-top: 72px;
      padding-top: 20px;
      border-top: 1px solid var(--border);
      font-size: 13px;
    }
    .icon-btn {
      background: none;
      border: none;
      color: var(--text);
      font-size: 18px;
      cursor: pointer;
    }
    .hero {
      margin-top: clamp(36px, 10vh, 100px);
      margin-bottom: 56px;
    }
    .hero h1 {
      font-size: clamp(28px, 6vw, 40px);
      line-height: 1.1;
      letter-spacing: -0.03em;
      margin: 0 0 16px;
    }
    .lead {
      font-size: 17px;
      margin: 0 0 28px;
      max-width: 46ch;
    }
    .how h2 {
      font-size: 15px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      margin: 0 0 12px;
    }
    .how ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 10px;
    }
    .how li {
      padding-left: 20px;
      position: relative;
    }
    .how li::before {
      content: '·';
      position: absolute;
      left: 4px;
      color: var(--accent);
      font-weight: 800;
    }

    .hero__native,
    .hero__native-caption {
      display: none;
    }
    :root[data-native] .hero__web {
      display: none;
    }
    :root[data-native] .hero__native {
      display: block;
    }
    :root[data-native] .hero__native-caption {
      display: block;
      margin: 8px 0 0;
      font-size: 13px;
      color: var(--text-muted);
    }
    :root[data-native] .how--web {
      display: none;
    }
    :root[data-native] .top__nav {
      margin-right: 52px;
    }

    .how-steps {
      list-style: none;
      margin: 0 0 28px;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px;
      font-weight: 600;
      font-size: clamp(17px, 4vw, 22px);
    }
    .how-steps li:not(:last-child)::after {
      content: '→';
      color: var(--accent);
      font-weight: 800;
      margin-left: 10px;
    }
  </style>
</BaseLayout>
