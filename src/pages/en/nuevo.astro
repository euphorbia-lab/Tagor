---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CreateForm from '../../components/CreateForm.tsx';
import { useTranslations } from '../../i18n/ui';

export const prerender = false;

const t = useTranslations('en');
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin;
---

<BaseLayout title={`${t('create.title')} · Tagor`} lang="en" noindex={true}>
  <main class="wrap">
    <a href="/en/" class="muted back">← Tagor</a>
    <h1>{t('create.title')}</h1>
    <CreateForm client:load lang="en" siteKey={siteKey} siteUrl={siteUrl} />
  </main>

  <style>
    .back {
      display: inline-block;
      margin-bottom: 20px;
    }
    h1 {
      font-size: 28px;
      letter-spacing: -0.02em;
      margin: 0 0 24px;
    }
  </style>
</BaseLayout>
