---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventView from '../../components/EventView.tsx';
import { getReadClient } from '../../lib/supabase';
import type { StoredEvent } from '../../lib/event';

// SSR, but only for the shell: the content is encrypted and can only be read in
// the browser, using the key from the URL fragment.
export const prerender = false;

const { slug } = Astro.params;

let ev: StoredEvent | null = null;
if (slug) {
  const { data, error } = await getReadClient().rpc('get_event', { p_slug: slug });
  if (error) {
    console.error('get_event failed:', error.message);
  } else if (Array.isArray(data) && data.length > 0) {
    ev = data[0] as StoredEvent;
  }
}

// Unknown or expired slug -> 404 (no hint that the event ever existed).
if (!ev) {
  return new Response(null, { status: 404 });
}

const lang = ev.lang === 'en' ? 'en' : 'es';
const L =
  lang === 'en'
    ? {
        generic: 'A Tagor event',
        footMade: 'Made with',
        footHow: 'link-only, no accounts, self-deleting',
        footOss: 'open source',
        legal: 'Legal',
        disclaimer: 'Created with Tagor, not by Tagor. Tagor is not responsible for this event.',
        locale: 'en-GB',
      }
    : {
        generic: 'Un evento en Tagor',
        footMade: 'Hecho con',
        footHow: 'solo con enlace, sin cuentas, se borra solo',
        footOss: 'código abierto',
        legal: 'Aviso legal',
        disclaimer: 'Creado con Tagor, no por Tagor. Tagor no se responsabiliza de este evento.',
        locale: 'es-ES',
      };

// The date is plaintext, so link previews can still say *when* something is on.
// The title cannot appear here: the server has no way to decrypt it.
const dateLabel = new Intl.DateTimeFormat(L.locale, {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
}).format(new Date(ev.start_at));

const origin = Astro.site ?? Astro.url.origin;
const viewUrl = new URL(`/e/${slug}`, origin).toString();
---

<BaseLayout
  title={`${L.generic} · ${dateLabel}`}
  description={`${L.generic} · ${dateLabel}`}
  noindex={true}
  lang={lang}
>
  <main class="wrap">
    <EventView
      client:load
      payload={ev.payload}
      start_at={ev.start_at}
      end_at={ev.end_at}
      all_day={ev.all_day}
      lang={lang}
      viewUrl={viewUrl}
    />

    <footer class="foot muted">
      <p class="foot__disc">{L.disclaimer}</p>
      {L.footMade} <a href="/">Tagor</a> · {L.footHow} ·
      <a href={lang === 'en' ? '/en/legal/' : '/legal/'}>{L.legal}</a> ·
      <a href="https://github.com/euphorbia-lab/Tagor" target="_blank" rel="noopener">{L.footOss}</a>
    </footer>
  </main>

  <style>
    .foot {
      font-size: 13px;
      border-top: 1px solid var(--border);
      padding-top: 20px;
      line-height: 1.7;
    }
    .foot__disc {
      margin: 0 0 8px;
    }
  </style>
</BaseLayout>
