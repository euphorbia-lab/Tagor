---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/hanken-grotesk';
import '../styles/global.css';
import CookieNotice from '../components/CookieNotice.astro';

export interface Props {
  title: string;
  description?: string;
  /** Absolute URL for OG image (social preview). */
  ogImage?: string;
  /** Absolute canonical URL for this page. */
  canonical?: string;
  /** Set true on private event pages so search engines never index them. */
  noindex?: boolean;
  lang?: string;
  /** Structured data object, rendered as a JSON-LD script element. */
  jsonLd?: Record<string, unknown>;
  /** Path to the ES and EN version of this same page, for hreflang alternates. Omit on pages with no translated counterpart (event/manage/create pages). */
  alternates?: { es: string; en: string };
  /** Set only on the two homepage variants (es: '/', en: '/en/'). Detects the
   * visitor's browser language once and redirects a non-Spanish visitor from
   * the Spanish homepage to the English one. A stored preference means we
   * never redirect the same visitor twice, and never fight manual navigation. */
  langRedirect?: 'es' | 'en';
}

const {
  title,
  description = '',
  ogImage,
  canonical,
  noindex = false,
  lang = 'es',
  jsonLd,
  alternates,
  langRedirect,
} = Astro.props;

// Always emit an explicit og:image (falls back to the logo) — scrapers that
// find none will otherwise guess, which can pick an awkward image on the page.
const origin = Astro.site ?? Astro.url.origin;
const resolvedOgImage = ogImage ?? new URL('/og-image.png', origin).toString();
// Event pages can no longer show their own card: their content is encrypted,
// so the server has nothing to render into one. Everything falls back to the
// shared social card (public/og-image.png, 1200x630) unless a page overrides it.
const ogImageWidth = ogImage ? 640 : 1200;
const ogImageHeight = ogImage ? 640 : 630;

// Only in production: registering the shell service worker in dev would let
// it cache astro's dev server output, which is exactly the kind of stale
// state it exists to avoid on live event pages.
const isProd = import.meta.env.PROD;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f5f5f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0f11" media="(prefers-color-scheme: dark)" />
    {/* Critical: set canvas color + background before external CSS loads, so
        navigating between pages never flashes a white/unstyled frame. */}
    <style is:inline>
      :root { color-scheme: light dark; background: #f5f5f3; }
      :root[data-theme='light'] { color-scheme: light; background: #f5f5f3; }
      :root[data-theme='dark'] { color-scheme: dark; background: #0e0f11; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) { color-scheme: dark; background: #0e0f11; }
      }
    </style>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {alternates && (
      <>
        <link rel="alternate" hreflang="es" href={new URL(alternates.es, origin).toString()} />
        <link rel="alternate" hreflang="en" href={new URL(alternates.en, origin).toString()} />
        <link rel="alternate" hreflang="x-default" href={new URL(alternates.es, origin).toString()} />
      </>
    )}

    {/* Open Graph - rendered server-side so social scrapers see real meta. */}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content={ogImageWidth.toString()} />
    <meta property="og:image:height" content={ogImageHeight.toString()} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={resolvedOgImage} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    {langRedirect && (
      <script is:inline define:vars={{ langRedirect }}>
        (() => {
          try {
            const stored = localStorage.getItem('tagor-lang');
            if (stored) return;
            const prefersSpanish = (navigator.language || '').toLowerCase().startsWith('es');
            if (langRedirect === 'es' && !prefersSpanish) {
              localStorage.setItem('tagor-lang', 'en');
              location.replace('/en/');
              return;
            }
            localStorage.setItem('tagor-lang', langRedirect);
          } catch (_) {}
        })();
      </script>
    )}

    {/* No-flash theme init: honor stored preference before first paint. */}
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('tagor-theme');
          if (t === 'dark' || t === 'light') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (_) {}
      })();
    </script>

    {/* Shell service worker: only for installability + a branded offline
        page. See public/sw.js for exactly what it does and does not cache. */}
    {isProd && (
      <script is:inline>
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch(() => {});
          });
        }
      </script>
    )}
  </head>
  <body>
    <slot />
    <CookieNotice lang={lang} />
  </body>
</html>
