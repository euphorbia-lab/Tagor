---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/hanken-grotesk';
import '../styles/global.css';
import CookieNotice from '../components/CookieNotice.astro';

export interface Props {
  title: string;
  description?: string;
  /** Absolute URL for OG image (social preview). */
  ogImage?: string;
  /** Absolute canonical URL for this page. */
  canonical?: string;
  /** Set true on private event pages so search engines never index them. */
  noindex?: boolean;
  lang?: string;
}

const {
  title,
  description = '',
  ogImage,
  canonical,
  noindex = false,
  lang = 'es',
} = Astro.props;

// Always emit an explicit og:image (falls back to the logo) — scrapers that
// find none will otherwise guess, which can pick an awkward image on the page.
const origin = Astro.site ?? Astro.url.origin;
const resolvedOgImage = ogImage ?? new URL('/logo.png', origin).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    {/* Critical: set canvas color + background before external CSS loads, so
        navigating between pages never flashes a white/unstyled frame. */}
    <style is:inline>
      :root { color-scheme: light dark; background: #f5f5f3; }
      :root[data-theme='light'] { color-scheme: light; background: #f5f5f3; }
      :root[data-theme='dark'] { color-scheme: dark; background: #0e0f11; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) { color-scheme: dark; background: #0e0f11; }
      }
    </style>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Open Graph - rendered server-side so social scrapers see real meta. */}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={resolvedOgImage} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={resolvedOgImage} />

    {/* No-flash theme init: honor stored preference before first paint. */}
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('tagor-theme');
          if (t === 'dark' || t === 'light') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <slot />
    <CookieNotice lang={lang} />
  </body>
</html>
